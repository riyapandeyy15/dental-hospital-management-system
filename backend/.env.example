# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# Server
PORT=5000
NODE_ENV=development

# CORS - the URL where the frontend runs
CORS_ORIGIN=http://localhost:5173

# MongoDB - either a local MongoDB instance or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/dental_hms

# JWT - use a long random string in every real environment, never this placeholder
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Used only by "npm run seed:admin" to create the first admin account.
# Do not put a real password here - set it in your local .env instead.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# AI Dental Assistant (Phase 9) - Anthropic Claude API key. Get one at
# https://console.anthropic.com/settings/keys. Never commit the real value;
# set it in your local .env only. Leaving it empty disables the AI endpoint.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=500
